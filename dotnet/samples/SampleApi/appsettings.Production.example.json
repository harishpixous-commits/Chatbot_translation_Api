{
  "AiSuite": {
    "ChatProvider": "OpenAiCompatible",
    "TranslationProvider": "AzureTranslator",
    "OpenAiCompatible": {
      "Endpoint": "https://<resource>.openai.azure.com/openai/v1",
      "Model": "gpt-4o-mini",
      "MaxTokens": 512,
      "Temperature": 0.7,
      "ApiKeyConfigKey": "AiSuite:ApiKeys:Chat",
      "RequireApiKey": true
    },
    "AzureTranslator": {
      "Endpoint": "https://api.cognitive.microsofttranslator.com",
      "Region": "<region>",
      "ApiKeyConfigKey": "AiSuite:ApiKeys:Translator"
    },
    "ChatDefaults": {
      "SystemPrompt": "You are a helpful assistant.",
      "MaxHistoryMessages": 20,
      "MaxMessageChars": 4000
    },
    "Languages": { "Default": "en", "Supported": [ "en", "ta", "hi" ] },
    "Resilience": { "TimeoutSeconds": 60, "MaxRetries": 2, "BaseDelayMs": 500 },
    "RateLimit": { "Enabled": true, "PermitLimit": 60, "WindowSeconds": 60 },
    "Security": { "RequireAuthorization": true }
  }
}
