<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>Pixous.AI.Providers</PackageId>
    <Version>1.2.0</Version>
    <Description>Built-in AI + translation providers (Echo, KnowledgeBase, OpenAI-compatible, Azure Translator, LibreTranslate) with retry/timeout resilience. No third-party NuGet dependencies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pixous.AI.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pixous.AI.Abstractions\Pixous.AI.Abstractions.csproj" />
    <ProjectReference Include="..\Pixous.AI.Core\Pixous.AI.Core.csproj" />
  </ItemGroup>

</Project>
