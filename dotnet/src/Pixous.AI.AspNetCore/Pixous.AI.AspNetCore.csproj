<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>Pixous.AI.AspNetCore</PackageId>
    <Version>1.2.0</Version>
    <Description>ASP.NET Core integration for Pixous AI: one-line DI (AddAiSuite), /api/ai endpoints with standard error envelope, runtime provider selection, optional rate limiting + authorization. No third-party NuGet dependencies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pixous.AI.Abstractions\Pixous.AI.Abstractions.csproj" />
    <ProjectReference Include="..\Pixous.AI.Core\Pixous.AI.Core.csproj" />
    <ProjectReference Include="..\Pixous.AI.Providers\Pixous.AI.Providers.csproj" />
  </ItemGroup>

</Project>
